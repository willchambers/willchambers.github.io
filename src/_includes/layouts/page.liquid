---
layout: layouts/base.liquid
---
<section class="panel panel--pad grid">
  <p class="label span-12">{{ label | default: title }}</p>
  <h1 class="span-9">{{ heading | default: title }}</h1>
  {%- if intro %}
  <p class="lede span-9">{{ intro }}</p>
  {%- endif %}
</section>

{%- assign body = content | strip %}
{%- if body != "" %}
<article class="panel panel--pad grid">
  <div class="span-3">
    {%- if show_links and profile.links.size > 0 %}
    <dl class="meta">
      {%- for link in profile.links %}
      <dt class="label">{{ link.label }}</dt><dd><a href="{{ link.url }}">{{ link.url | replace: "https://", "" | replace: "mailto:", "" }}</a></dd>
      {%- endfor %}
    </dl>
    {%- endif %}
  </div>
  <div class="span-9 prose">
    {{ content }}
  </div>
</article>
{%- endif %}
