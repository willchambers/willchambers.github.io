{%- comment %} Topic filter buttons. Expects `topics` (list), `target` (CSS selector)
and `noun` (what's being counted). Renders nothing when there are no topics. {% endcomment -%}
{%- if topics.size > 0 %}
<div class="filter cluster" data-component="filter" data-filter-target="{{ target }}" data-filter-noun="{{ noun }}" role="group" aria-label="Filter by topic">
  <button class="tag tag--button" type="button" data-filter="*" aria-pressed="true">All</button>
  {%- for topic in topics %}
  <button class="tag tag--button" type="button" data-filter="{{ topic | slugify }}" aria-pressed="false">{{ topic }}</button>
  {%- endfor %}
  <span class="filter__status visually-hidden" aria-live="polite"></span>
</div>
{%- endif %}
